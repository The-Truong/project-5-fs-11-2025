extends ../layouts/default.pug

block main
  h1.box-title Quản lý tour
  .section-4
    .inner-wrap
      .inner-item
        i.fa-solid.fa-filter
        | Bộ lọc
      .inner-item
        select(filter name="status")
          option(value="") Trạng thái
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
      .inner-item
        select(filter name="createdBy")
          option(value="") Người tạo
          each item in accountList
            option(value=item.id) #{item.fullName}
      .inner-item
        input(type="date" filter name="startDate" class="inner-date")
        span -
        input(type="date" filter name="endDate" class="inner-date")
      .inner-item
        select(filter name="category")
          option(value="") Danh mục
          each item in categoryList
            option(value=item.id) #{item.name}
      .inner-item
        select(filter name="price")
          option(value="") Mức giá
          option(value="duoi-1-trieu") Dưới 1 triệu
          option(value="tu-1-3-trieu") 1 - 3 triệu
          option(value="tren-3-trieu") Trên 3 triệu
      .inner-item.inner-reset(button-reset-filter)
        i.fa-solid.fa-arrow-rotate-right
        | Xóa bộ lọc
  .section-5
    .inner-wrap
      .inner-action(change-multi data-api=`/${pathAdmin}/tour/change-multi`)
        .inner-item
          select
            option(value="") -- Hành động --
            option(value="active") Hoạt động
            option(value="inactive") Tạm dừng
            option(value="delete") Xóa
        button Áp dụng
      .inner-search
        i.fa-solid.fa-magnifying-glass
        input(type="text" placeholder="Tìm kiếm" input-search)
      a.inner-create(href=`/${pathAdmin}/tour/create`) + Tạo mới
      a.inner-trash(href=`/${pathAdmin}/tour/trash`) Thùng rác
  .section-6
    .table-2
      table
        thead
          tr
            th 
              input.inner-checkall(type="checkbox" check-all)
            th Tên tour
            th Ảnh đại diện
            th Giá
            th Còn lại
            th Vị trí
            th Trạng thái
            th Tạo bởi
            th Cập nhật bởi
            th Hành động
        tbody
          each item in tourList
            tr
              td 
                input.inner-check(type="checkbox" value=item.id check-item)
              td #{item.name}
              td
                img.inner-avatar(src=item.avatar alt="avatar")
              td
                div NL: #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                div TE: #{item.priceNewChildrent.toLocaleString("vi-VN")}đ
                div EB: #{item.priceNewBaby.toLocaleString("vi-VN")}đ
              td
                div NL: #{item.stockAdult}
                div TE: #{item.stockChildrent}
                div EB: #{item.stockBaby}
              td #{item.position}
              td
                if(item.status == "active")
                  .tag.tag-green Hoạt động
                else if(item.status == "inactive")
                  .tag.tag-red Tạm dừng
              td
                if(item.createdBy)
                  div #{item.createdByName}
                  .inner-date #{item.createdAtFormat}
              td
                if(item.updatedBy)
                  div #{item.updatedByName}
                  .inner-date #{item.updatedAtFormat}
              td
                .inner-action
                  a.inner-edit(
                    title="Sửa tour"
                    href=`/${pathAdmin}/tour/edit/${item.id}`
                    ) 
                    i.fa-regular.fa-pen-to-square
                  a.inner-remove(
                    title="Xóa tour"
                    href="javascript:;"
                    button-delete
                    data-api=`/${pathAdmin}/tour/delete/${item.id}`
                  )
                    i.fa-regular.fa-trash-can
  .box-pagination
    .inner-label Hiển thị #{pagination.skip + 1} - #{pagination.skip + tourList.length} của #{pagination.totalRecord}
    .inner-select
      select(select-pagination)
        - for(let i = 1; i <= pagination.totalPage ; i++)
          option(value=i) Trang #{i}

  