extends ../layouts/account.pug

block main
  .form-account
    .inner-title Đổi mật khẩu
    .inner-desc Vui lòng nhập mật khẩu để tiếp tục
    form.inner-form(id="resetPasswordForm")
      .inner-group
        label(for="password") Mật khẩu mới
        input.inner-control(type="password" id="password" name="password")
      .inner-group
        label(for="password") Xác nhận mật khẩu
        input.inner-control(type="password" id="confirmPassword" name="confirmPassword")
      button.inner-button Thay đổi
    .inner-more
      span Bạn đã nhớ mật khẩu?
      a(href=`/${pathAdmin}/account/register`) Tạo tài khoản