extends ../layouts/default.pug

block title
  title Tạo tài khoản quản trị

block main
  .box-title Tạo tài khoản quản trị
  .section-7
    form(id="settingAccountAdminCreate")
      .inner-group
        label.inner-label(for="fullName") Họ tên *
        input(type="text" id="fullName" name="fullName")
      .inner-group
        label.inner-label(for="email") Email *
        input(type="email" id="email" name="email")
      .inner-group
        label.inner-label(for="phone") Số điện thoại
        input(type="text" id="phone" name="phone")
      .inner-group
        label.inner-label(for="role") Chọn quyền
        select(id="role" name="role")
          option(value="id-quan-tri-vien") Quản trị viên
          option(value="id-quan-ly-tour") Quản lý tour
          option(value="id-quan-ly-don-hang") Quản lý đơn hàng
      .inner-group
        label.inner-label(for="positionCompany") Chức vụ
        input(type="text" id="positionCompany" name="positionCompany")
      .inner-group
        label.inner-label(for="status") Trạng thái
        select(id="status")
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
      .inner-group
        label.inner-label(for="password") Mật khẩu *
        input(type="text" id="password" name="password")
      .inner-group.inner-two-col
        label.inner-label(for="avatar") Ảnh đại diện
        div.inner-upload-image
          input(type="file" id="avatar" name="avatar" accept="image/*" filepond-image)
      .inner-button.inner-two-col
        button Tạo mới
    .inner-back
      a(href="#") Quay lại danh sách