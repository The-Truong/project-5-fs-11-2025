extends ../layouts/default.pug

block main
  .box-title Nhóm quyền
  .section-5
    .inner-wrap
      .inner-action
        .inner-item
          select(name="")
            option(value="") -- Hành động --
            option(value="") Xóa
        button Áp dụng
      .inner-search
        i.fa-solid.fa-magnifying-glass
        input(type="text" placeholder="Tìm kiếm")
      a.inner-create(href=`/${pathAdmin}/setting/role/create`) + Tạo mới
  .section-6
    .table-2
      table
        thead
          tr
            th 
              input.inner-checkall(type="checkbox" check-all)
            th Tên nhóm quyền
            th Mô tả ngắn
            th Hành động
        tbody
          each item in roleList
            tr
              td 
                input.inner-check(type="checkbox" check-item)
              td #{item.name}
              td #{item.description}
              td
                .inner-action
                  a.inner-edit(href=`/${pathAdmin}/setting/role/edit/${item.id}`) 
                    i.fa-regular.fa-pen-to-square
                  a.inner-remove(href="#")
                    i.fa-regular.fa-trash-can
  .box-pagination
    .inner-label Hiển thị #{pagination.skip + 1} - #{pagination.skip + roleList.length} của #{pagination.totalRecord}
    .inner-select
      select(select-pagination)
        - for(let i = 1; i <= pagination.totalPage; i++)
          option(value=i) Trang #{i}
          