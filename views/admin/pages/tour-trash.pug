extends ../layouts/default.pug

block main
  h1.box-title Thùng rác tour
  
  .section-5
    .inner-wrap
      .inner-action
        .inner-item
          select(name="user")
            option(value="") -- Hành động --
            option(value="1") Tạm dừng
            option(value="2") Hoạt động
        button Áp dụng
      .inner-search
        i.fa-solid.fa-magnifying-glass
        input(type="text" placeholder="Tìm kiếm")
  .section-6
    .table-2
      table
        thead
          tr
            th 
              input.inner-checkall(type="checkbox" check-all)
            th Tên tour
            th Ảnh đại diện
            th Giá
            th Còn lại
            th Vị trí
            th Trạng thái
            th Tạo bởi
            th Xóa bởi
            th Hành động
        tbody
          each item in tourList
            tr
              td 
                input.inner-check(type="checkbox" value=item.id check-item)
              td #{item.name}
              td
                img.inner-avatar(src=item.avatar alt="avatar")
              td
                div NL: #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                div TE: #{item.priceNewChildrent.toLocaleString("vi-VN")}đ
                div EB: #{item.priceNewBaby.toLocaleString("vi-VN")}đ
              td
                div NL: #{item.stockAdult}
                div TE: #{item.stockChildrent}
                div EB: #{item.stockBaby}
              td #{item.position}
              td
                if(item.status == "active")
                  .tag.tag-green Hoạt động
                else if(item.status == "inactive")
                  .tag.tag-red Tạm dừng
              td
                if(item.createdBy)
                  div #{item.createdByName}
                  .inner-date #{item.createdAtFormat}
              td
                if(item.deletedBy)
                  div #{item.deletedByName}
                  .inner-date #{item.deletedAtFormat}
              td
                .inner-action
                  a.inner-edit(href="#") 
                    i.fa-solid.fa-rotate-left
                  a.inner-remove(href="#")
                    i.fa-regular.fa-trash-can
  .box-pagination
    .inner-title Hiển thị 1 - 9 của 78
    .inner-select
      select(name="pagination")
        option(value="1") Trang 1
        option(value="2") Trang 2
        option(value="3") Trang 3

  