extends ../layouts/default.pug

block main
  .box-title Tạo nhóm quyền
  .section-7
    form(id="settingRoleCreateForm")
      .inner-group
        label.inner-label(for="name") Tên nhóm quyền *
        input(type="text" id="name" name="name")
      .inner-group
        label.inner-label(for="description") Mô tả ngắn
        input(type="text" id="descripttion" name="description")
      .inner-group
        label.inner-label Phân quyền
        .inner-checkbox-list
          each item, index in permissionList
            .inner-checkbox-item
              input(
                type="checkbox" 
                name="permissions" 
                id=`permission-${index}`
                value=item.value)
              label(for=`permission-${index}`) #{item.label}
      .inner-button.inner-two-col
        button Tạo mới
    .inner-back
      a(href=`/${pathAdmin}/setting/role/list`) Quay lại danh sách