extends ../layouts/account.pug

block main
  .form-account
    .inner-title Quên mật khẩu
    .inner-desc Vui lòng nhập email để tiếp tục
    form.inner-form(id="forgotPasswordForm")
      .inner-group
        label(for="email") Email *
        input.inner-control(type="email" id="email" name="email" placeholder="Ví dụ: levana@gmail.com")
      button.inner-button Gửi mã OTP
    .inner-more
      span Bạn đã nhớ mật khẩu?
      a(href=`/${pathAdmin}/account/login`) Đăng nhập