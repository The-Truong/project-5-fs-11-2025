extends ../layouts/default.pug

block main
  .box-title #{pageTitle}
  .section-7
    form(id="settingRoleEditForm")
      input(type="hidden" name="id" value=roleDetail.id)
      .inner-group
        label.inner-label(for="name") Tên nhóm quyền *
        input(type="text" id="name" name="name" value=roleDetail.name)
      .inner-group
        label.inner-label(for="description") Mô tả ngắn
        input(type="text" id="description" name="description" value=roleDetail.description)
      .inner-group
        label.inner-label Phân quyền
        .inner-checkbox-list
          each item, index in permissionList
            .inner-checkbox-item
              input(
                type="checkbox" 
                name="permissions" 
                id=`permission-${index}`
                value=item.value
                checked=(roleDetail.permissions.includes(item.value))
              )
              label(for=`permission-${index}`) #{item.label}
      .inner-button.inner-two-col
        button Cập nhật
    .inner-back
      a(href=`/${pathAdmin}/setting/role/list`) Quay lại danh sách