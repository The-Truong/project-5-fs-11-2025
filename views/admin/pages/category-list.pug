extends ../layouts/default.pug

block main
  h1.box-title Quản lý danh mục
  .section-4
    .inner-wrap
      .inner-item
        i.fa-solid.fa-filter
        | Bộ lọc
      .inner-item
        select(filter name="status")
          option(value="") Trạng thái
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
      .inner-item
        select(filter name="createdBy")
          option(value="") Người tạo
          each item in accountList
            option(value=item.id) #{item.fullName}
      .inner-item
        input(type="date" filter name="startDate" class="inner-date")
        span -
        input(type="date" filter name="endDate" class="inner-date")
      .inner-item.inner-reset
        i.fa-solid.fa-arrow-rotate-right
        | Xóa bộ lọc
  .section-5
    .inner-wrap
      .inner-action
        .inner-item
          select(name="user")
            option(value="") -- Hành động --
            option(value="1") Tạm dừng
            option(value="2") Hoạt động
        button Áp dụng
      .inner-search
        i.fa-solid.fa-magnifying-glass
        input(type="text" placeholder="Tìm kiếm")
      a.inner-create(href=`/${pathAdmin}/category/create`) + Tạo mới
  .section-6
    .table-2
      table
        thead
          tr
            th 
              input.inner-checkall(type="checkbox" name="selectAll")
            th Tên danh mục
            th Ảnh đại diện
            th Vị trí
            th Trạng thái
            th Tạo bởi
            th Cập nhật bởi
            th Hành động
        tbody
          each item in categoryList
            tr
              td 
                input.inner-check(type="checkbox" name="selectItem")
              td #{item.name}
              td
                img.inner-avatar(src=item.avatar alt="avatar")
              td #{item.position}
              td
                if(item.status == "active")
                  .tag.tag-green Hoạt động
                else if(item.status == "inactive")
                  .tag.tag-red Tạm dừng
              td 
                if(item.createdBy)
                  div #{item.createdByName}
                  .inner-date #{item.createdAtFormat}
              td
                if(item.updatedBy)
                  div #{item.updatedByName}
                  .inner-date #{item.updatedAtFormat}
              td
                .inner-action
                  a.inner-edit(href=`/${pathAdmin}/category/edit/${item.id}`) 
                    i.fa-regular.fa-pen-to-square
                  a.inner-remove(
                    href="javascript:;"
                    button-delete
                    data-api=`/${pathAdmin}/category/delete/${item.id}`
                  )
                    i.fa-regular.fa-trash-can
  .box-pagination
    .inner-title Hiển thị 1 - 9 của 78
    .inner-select
      select(name="pagination")
        option(value="1") Trang 1
        option(value="2") Trang 2
        option(value="3") Trang 3

  