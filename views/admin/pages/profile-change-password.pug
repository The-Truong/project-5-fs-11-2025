extends ../layouts/default.pug

block title
  title Đổi mật khẩu

block main
  .box-title Đổi mật khẩu
  .section-7
    form(id="profileChangePasswordForm")
      .inner-group
        label.inner-label(for="password") Mật khẩu mới *
        input(type="password" id="password" name="password")
      .inner-group
        label.inner-label(for="confirmPassword") Nhập lại mật khẩu mới *
        input(type="password" id="confirmPassword" name="confirmPassword")
      .inner-button.inner-two-col
        button Đổi mật khẩu