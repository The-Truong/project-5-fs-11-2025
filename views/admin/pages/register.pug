extends ../layouts/account.pug

block main
  .form-account
    .inner-title Đăng ký
    .inner-desc Tạo một tài khoản để tiếp tục
    form.inner-form(id="registerForm")
      .inner-group
        label(for="fullName") Họ tên *
        input.inner-control(type="text" id="fullName" name="fullName" placeholder="Ví dụ: Lê Văn A")
      .inner-group
        label(for="email") Email *
        input.inner-control(type="email" id="email" name="email" placeholder="Ví dụ: levana@gmail.com")
      .inner-group
        label(for="password") Mật khẩu *
        input.inner-control(type="password" id="password" name="password")
      .inner-meta
        .inner-check
          input(type="checkbox" id="agree" name="agree")
          label(for="agree") Tôi chấp nhận các điều khoản và điều kiện
      button.inner-button Đăng ký
    .inner-more
      span Bạn đã có tài khoản?
      a(href=`/${pathAdmin}/account/login`) Đăng nhập