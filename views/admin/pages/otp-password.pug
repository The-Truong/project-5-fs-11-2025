extends ../layouts/account.pug

block main
  .form-account
    .inner-title Nhập mã OTP
    .inner-desc Vui lòng nhập mã OTP để tiếp tục
    form.inner-form(id="otpPasswordForm")
      .inner-group
        label(for="email") Email *
        input.inner-control(type="text" id="email" name="email" value=email readonly)
      .inner-group
        label(for="otp") Mã OTP *
        input.inner-control(type="text" id="otp" name="otp" placeholder="Ví dụ: 123456")
      button.inner-button Xác thực
    .inner-more
      span Bạn đã nhớ mật khẩu?
      a(href=`/${pathAdmin}/account/login`) Đăng nhập