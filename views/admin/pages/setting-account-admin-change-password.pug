extends ../layouts/default.pug

block main
  .box-title #{pageTitle}
  .section-7
    form(id="settingAccountAdminChangePassword")
      input(type="hidden" name="id" value=accountDetail.id)
      .inner-group
        label.inner-label(for="fullName") Họ tên
        input(type="text" id="fullName" name="fullName" value=accountDetail.fullName readonly)
      .inner-group
        label.inner-label(for="email") Email
        input(type="email" id="email" name="email" value=accountDetail.email readonly)
      .inner-group
        label.inner-label(for="password") Mật khẩu *
        input(type="text" id="password" name="password")
      .inner-button.inner-two-col
        button Đổi mật khẩu
    .inner-back
      a(href=`/${pathAdmin}/setting/account-admin/list`) Quay lại danh sách