header.header 
  a.inner-logo(href=`/${pathAdmin}/dashboard`)
    span 28
    span Admin
  .inner-wrap
    .inner-notify
      img(src="/admin/assets/images/bell.svg" alt="Notification")
      span 6
    .inner-account
      img(src=account.avatar alt="Avatar")
      .inner-info
        .inner-name #{account.fullName}
        .inner-role #{role.name}
    button.inner-button-menu
      i.fa-solid.fa-bars